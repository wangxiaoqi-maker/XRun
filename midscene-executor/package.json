{
  "name": "xrun-midscene-executor",
  "version": "1.0.0",
  "description": "XRun Midscene TypeScript Test Executor",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:android": "vitest run --dir tests/android",
    "test:ios": "vitest run --dir tests/ios",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:report": "vitest run --reporter=verbose --reporter=json --outputFile=./reports/results.json"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@midscene/android": "^1.3.5",
    "@midscene/core": "^1.3.5",
    "@midscene/ios": "^1.3.5",
    "@midscene/shared": "^1.3.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
